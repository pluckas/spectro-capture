# Ignore everything
*

# Allow Git to descend into directories
!*/

# Keep Python files anywhere
!*.py

# Keep these essentials
!.gitignore
!README.md
!LICENSE
!docs/
!docs/**

# Exclude archived scripts
archived/

# Exclude focus-related scripts
gui_focus.py
focus_control.py

# Browser monitor assets
!web_monitor/index.html
!web_monitor/style.css
!web_monitor/app.js
